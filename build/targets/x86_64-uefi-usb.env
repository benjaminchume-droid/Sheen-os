# Compatibility projection of configs/targets/x86_64-uefi-usb.toml.
# Do not add platform policy here.
SHEEN_TARGET=x86_64-uefi-usb
SHEEN_ARCH=x86_64
SHEEN_BOOT=uefi
SHEEN_MODE=usb
SHEEN_KERNEL_VERSION=6.12.51
SHEEN_KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.12.51.tar.xz
SHEEN_KERNEL_CONFIG_FRAGMENT=build/kernel.fragment
SHEEN_KERNEL_DEFCONFIG=kernel/config/x86_64_defconfig
SHEEN_IMAGE_SIZE_MB=512
SHEEN_IMAGE_FORMAT=gpt
SHEEN_ESP_FORMAT=fat32
SHEEN_BOOTLOADER=grub
SHEEN_BOOT_REMOVABLE=1
SHEEN_BOOT_NVRAM=0
SHEEN_ESP_LABEL=SHEEN
SHEEN_ESP_OFFSET_BYTES=1048576
